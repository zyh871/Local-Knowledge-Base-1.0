# 离线 / 零出域部署环境模板
#
# 复制为仓库根目录的 .env 后，**务必替换所有 <...> 占位值**。
# 自检：python backend/scripts/compliance_check.py --strict
#
# 说明：本模板假定模型在本机/内网通过 Ollama 提供，因此不需要任何云端 API Key。

# ── 运行环境 ──────────────────────────────────────────────
APP_ENV=prod

# ── 安全（必须替换）──────────────────────────────────────
# 生成方式：python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=<replace-with-a-random-48-byte-token>
ADMIN_USERNAME=admin
ADMIN_PASSWORD=<replace-with-a-strong-password>
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── 跨域（改为实际访问域名，禁止 *）──────────────────────
CORS_ORIGINS=http://localhost,http://127.0.0.1

# ── 模型：本地 Ollama（零出域）──────────────────────────
MODEL_BACKEND=ollama
# Docker Desktop: host.docker.internal；Linux 可改为宿主机内网 IP
OLLAMA_BASE_URL=http://host.docker.internal:11434
LLM_MODEL=llama3.2:3b
VISION_MODEL=llama3.2-vision
EMBEDDING_MODEL=nomic-embed-text
# 换嵌入模型后必须重建向量库：POST /rebuild-vectorstore

# ── Redis ────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
REDIS_FALLBACK_TO_MEMORY=false
GRAPH_CHECKPOINTER=redis

# ── 关闭高危能力 ─────────────────────────────────────────
WORKFLOW_FS_BROWSE=false
ALLOW_CUSTOM_MODELS=false
WORKFLOW_WRITE_TO_BOUND_FOLDER=false

# ── 生成能力（离线环境建议全部留空）─────────────────────
# CREATION_PROVIDERS=
# ZHIPU_API_KEY=
# MODELSCOPE_API_KEY=
# TAVILY_API_KEY=
