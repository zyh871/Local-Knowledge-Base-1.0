# ============================================================
#  本地知识库问答系统 - 环境变量配置示例
#  复制本文件为 .env 并填入实际值：cp .env.example .env
# ============================================================

# ----- 端口配置 -----
BACKEND_PORT=8000
FRONTEND_PORT=80

# ----- 模型后端（modelscope/openai/baidu_qianfan/ollama/zhipu/local/mock） -----
MODEL_BACKEND=zhipu

# ----- 智谱 AI 配置（OpenAI 兼容协议）-----
# 必须：智谱开放平台 API Key，格式 <id>.<secret>
# 获取地址：https://open.bigmodel.cn/
ZHIPU_API_KEY=your-zhipu-api-key
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# 可选：覆盖默认模型（默认 glm-4-flash / glm-4v-flash / embedding-3）
# LLM_MODEL=glm-4-flash
# VISION_MODEL=glm-4v-flash
# EMBEDDING_MODEL=embedding-3

# 可选：前端「模型切换」控件的候选清单（逗号分隔）。留空则用后端内置候选。
# 只允许切换到清单内的模型 —— 防止任意模型名透传到上游。
# LLM_CHOICES=glm-4-flash,glm-4-air,glm-4-plus

# 可选：单次回答的最大输出 token 数。留空 = 用 provider 默认（智谱约 1024）。
# ⚠️ 回答"莫名其妙变短"、生成的代码是半截的，优先看这一项：
#    默认上限会把长脚本腰斩。注意不要超过模型自身上限（glm-4 系列约 4095）。
MAX_TOKENS=4095

# ----- ModelScope 配置（MODEL_BACKEND=modelscope 时必填）-----
# MODELSCOPE_API_KEY=your-modelscope-token
# MODELSCOPE_BASE_URL=https://api-inference.modelscope.cn/v1

# ----- Tavily 联网搜索 API（可选，缺失时联网搜索功能不可用） -----
TAVILY_API_KEY=your-tavily-api-key

# ----- 安全配置 -----
# 必须：管理员账号密码（缺失时服务拒绝启动）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# 必须：JWT 签名密钥，生产环境务必修改
JWT_SECRET_KEY=please-change-this-to-a-strong-random-string-in-production
JWT_ALGORITHM=HS256
# Token 过期时间（分钟）
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ----- 限流配置 -----
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# ----- 日志配置 -----
LOG_LEVEL=INFO
LOG_FILE_ENABLED=true
LOG_MAX_FILE_SIZE_MB=10
LOG_MAX_BACKUP_COUNT=30

# ----- CORS 配置（多个用逗号分隔） -----
CORS_ORIGINS=http://localhost,http://localhost:80,http://127.0.0.1,http://127.0.0.1:80

# ----- 检索配置（可选调优） -----
RETRIEVER_K=3
CHUNK_SIZE=500
CHUNK_OVERLAP=50
CONVERSATION_WINDOW_SIZE=5
RRF_K=60
RRF_TOP_N=5

# ============================================================
#  Redis（v4 新增）
#  启动：docker compose up -d redis
#  说明：Redis Stack 镜像含 RediSearch，LangGraph checkpoint 需要它
# ============================================================
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=50
REDIS_KEY_PREFIX=kbqa
# 生产环境务必设为 false（否则 Redis 故障时会静默退化为单机语义）
REDIS_FALLBACK_TO_MEMORY=true
REDIS_TTL_SESSION=604800
REDIS_TTL_PROFILE_CACHE=3600
REDIS_TTL_RETRIEVAL_CACHE=300
REDIS_TTL_EMBEDDING_CACHE=86400
REDIS_TTL_SHARE_DEFAULT=86400
REDIS_TTL_LOCK_DEFAULT=30
REDIS_TTL_LOCK_REBUILD=600

# ============================================================
#  LangGraph
#  状态图是唯一的业务编排实现（无灰度开关）
# ============================================================
# redis | memory | none
GRAPH_CHECKPOINTER=memory
GRAPH_MAX_AGENT_ITERATIONS=5
GRAPH_RECURSION_LIMIT=25

# ============================================================
#  OCR（图片类文档解析）
#  需要本机安装 Tesseract OCR（含中文语言包）。
#  未安装时图片上传会明确报错「OCR 引擎不可用」，
#  不再静默解析为 0 页 —— 两类失败必须能区分开。
# ============================================================
# 可执行文件路径。留空 = 自动发现（PATH 与 Program Files 等常见位置）。
# Windows 默认安装位置：
#   C:\Program Files\Tesseract-OCR\tesseract.exe
# OCR_TESSERACT_CMD=
# 语言包目录。留空 = 自动发现。
# ⚠️ Windows 下 Program Files 需要管理员权限才能写入，
#    所以追加语言包（chi_sim/chi_tra）通常放到用户目录，再用此项指过去。
#    Linux 常规值：/usr/share/tesseract-ocr/5/tessdata
# OCR_TESSDATA_PREFIX=C:\Users\<you>\tessdata
# 识别语言（+ 连接）：chi_sim=简体中文，chi_tra=繁体中文，eng=英文
OCR_LANGUAGES=chi_sim+eng
OCR_ENABLED=true

# ============================================================
#  AI 工作流模式
#  设计文档：docs/WORKFLOW_MODE_DESIGN.md
#  数据独立于对话（workflow.db + workspaces/ 目录）；
#  临时文件只作当前任务的上下文，**不进知识库、不进向量库**。
# ============================================================
# 库与工作区目录；留空自动落在 data/ 下
# WORKFLOW_DB_PATH=
# WORKFLOW_WORKSPACE_ROOT=
# manual = 人工逐步审查（每步确认）；auto = AI 自动执行
WORKFLOW_DEFAULT_MODE=manual
# 单个任务最多步骤数，超出时要求用户裁剪 —— 防规划失控与成本失控
WORKFLOW_MAX_STEPS=12
# 澄清追问轮次上限，到顶不再追问，改为「列出假设」交给用户确认
WORKFLOW_MAX_CLARIFY_ROUNDS=3
# 临时文件 TTL（天）
WORKFLOW_FILE_TTL_DAYS=7
# 解析后小于此长度直接全文进 prompt；更大则分块召回，更大则先摘要
WORKFLOW_FILE_INLINE_MAX_CHARS=8000
WORKFLOW_MAX_FILE_MB=20
WORKFLOW_STEP_TIMEOUT_SECONDS=180
# 单个任务允许的联网搜索次数上限
WORKFLOW_SEARCH_MAX_CALLS_PER_RUN=5
# 无论哪种模式，这些工具都必须单独审批（可执行代码/写文件）
WORKFLOW_REQUIRE_APPROVAL_TOOLS=code_executor,file_write
# ── 产出文件（file_write）────────────────────────────────────
# 允许**写出**的后缀。留空 = 用内置默认（.py .js .md .json .csv .html …）。
# 这是"写"白名单，与"允许引用"的读白名单不是一回事。
# WORKFLOW_WRITE_ALLOWED_EXTENSIONS=.py,.js,.md
# 单个产出文件大小上限（KB）
# WORKFLOW_WRITE_MAX_KB=512
# 是否允许写进工作区**已绑定**的本地文件夹。false = 只能写进任务产物目录。
# 多用户/对外部署建议 false（这条会往用户磁盘落文件）。
# WORKFLOW_WRITE_TO_BOUND_FOLDER=true

# ── 代码沙箱 ─────────────────────────────────────────────────
# 执行超时（秒）。超时后**真的会终止**执行，而不是只停止等待。
# CODE_EXEC_TIMEOUT=10
# 允许 import 的标准库白名单（逗号分隔）。留空 = 内置默认（math/json/re/csv…）。
# 用 `none` 可显式完全禁止 import。os/sys/subprocess/socket/ctypes/importlib 永不允许。
# CODE_EXEC_ALLOWED_MODULES=

# 运行环境：dev | test | prod
APP_ENV=dev
