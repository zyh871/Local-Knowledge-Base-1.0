# ============================================================
#  本地知识库问答系统 - 环境变量配置示例
#  复制本文件为 .env 并填入实际值：cp .env.example .env
# ============================================================

# ----- 端口配置 -----
BACKEND_PORT=8000
FRONTEND_PORT=80

# ----- 模型后端（modelscope/openai/baidu_qianfan/ollama/local/mock） -----
MODEL_BACKEND=modelscope

# ----- ModelScope API 配置 -----
# 必须：ModelScope 平台 API 令牌
MODELSCOPE_API_KEY=ms-e18298f2-3f08-4311-89e7-de0bdd0e37d0
# 可选：API 基础地址
MODELSCOPE_BASE_URL=https://api-inference.modelscope.cn/v1
# 可选：视觉模型（图片问答），默认 Qwen/Qwen3.5-35B-A3B（一体化模型，支持图文）
VISION_MODEL=Qwen/Qwen3.5-35B-A3B

# ----- Tavily 联网搜索 API（可选） -----
TAVILY_API_KEY=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

# ----- 安全配置 -----
# 必须：JWT 签名密钥，生产环境务必修改
JWT_SECRET_KEY=please-change-this-to-a-strong-random-string-in-production
JWT_ALGORITHM=HS256
# Token 过期时间（分钟）
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ----- 限流配置 -----
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# ----- 日志配置 -----
LOG_LEVEL=INFO
LOG_FILE_ENABLED=true
LOG_MAX_FILE_SIZE_MB=10
LOG_MAX_BACKUP_COUNT=30

# ----- CORS 配置（多个用逗号分隔） -----
CORS_ORIGINS=http://localhost,http://localhost:80,http://127.0.0.1,http://127.0.0.1:80

# ----- 检索配置（可选调优） -----
RETRIEVER_K=3
CHUNK_SIZE=500
CHUNK_OVERLAP=50
CONVERSATION_WINDOW_SIZE=5
RRF_K=60
RRF_TOP_N=5
